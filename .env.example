# Environment Configuration for InfraSim
NODE_ENV=development

# WalletConnect Project ID - Get this from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id-here

# RPC Configuration
NEXT_PUBLIC_CUSTOM_RPC_URL=http://localhost:8545
ETHEREUM_RPC_URL=http://ethereum-sim:8545

# App URL for server-side requests
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_HOST=0.0.0.0

# Matrix Configuration
MATRIX_SERVER_NAME=localhost
MATRIX_BASE_URL=http://matrix:8008
MATRIX_DB_PASSWORD=synapse_password

# Development Settings
WATCHPACK_POLLING=true

# Wallet Authentication
JWT_SECRET=your-super-secure-jwt-secret-key-here-minimum-32-characters

# Smart Contract Addresses (automatically populated after deployment)
API_ACCESS_CONTRACT_ADDRESS=0x0165878A594ca255338adfa4d48449f69242Eb8F
CONTRACT_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# API Keys for AI Models (add as needed)
# Lambda Labs API Key (backend only - not exposed to frontend)
# LAMBDA_LABS_API_KEY=secret_your-lambda-key-here

# Optional: OpenAI API Key for backend fallback
# OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Anthropic API Key for backend fallback  
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Future: JWT Auth for secure relay
# NEXT_PUBLIC_RPC_AUTH_TOKEN=your-jwt-token-here