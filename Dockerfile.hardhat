FROM node:18-alpine

# Install dependencies
RUN apk add --no-cache git python3 make g++ curl bash

# Set working directory
WORKDIR /app

# Create package.json for Hardhat with Polygon support
COPY <<EOF package.json
{
  "name": "infrasim-hardhat-polygon",
  "version": "1.0.0",
  "description": "Hardhat Polygon testnet environment for InfraSim",
  "scripts": {
    "node": "hardhat node --network hardhat",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js --network hardhat",
    "setup": "node scripts/setup-network.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "hardhat": "^2.19.0",
    "@openzeppelin/contracts": "^5.0.0",
    "ethers": "^6.8.0",
    "express": "^4.18.0",
    "cors": "^2.8.5"
  }
}
EOF

# Install packages
RUN npm install

# Create Hardhat config for Polygon testnet
COPY <<EOF hardhat.config.js
require("@nomicfoundation/hardhat-toolbox");

/** @type import('hardhat/config').HardhatUserConfig */
module.exports = {
  solidity: {
    version: "0.8.20",
    settings: {
      optimizer: {
        enabled: true,
        runs: 200
      }
    }
  },
  networks: {
    hardhat: {
      chainId: parseInt(process.env.CHAIN_ID) || 80001,
      blockGasLimit: 20000000,
      gasPrice: 20000000000,
      accounts: {
        mnemonic: "test test test test test test test test test test test junk",
        count: 20,
        accountsBalance: "10000000000000000000000" // 10,000 ETH
      },
      mining: {
        auto: true,
        interval: parseInt(process.env.BLOCK_TIME) * 1000 || 2000
      }
    },
    localhost: {
      url: "http://localhost:8545",
      chainId: parseInt(process.env.CHAIN_ID) || 80001,
      accounts: [
        "0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80", // Account #0
        "0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d", // Account #1
        "0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a", // Account #2
      ]
    }
  },
  paths: {
    sources: "./contracts",
    tests: "./test",
    cache: "./cache",
    artifacts: "./artifacts"
  }
};
EOF

# Create network setup script
COPY <<EOF scripts/setup-network.js
const fs = require("fs");
const path = require("path");

async function setupNetwork() {
  console.log("🔧 Setting up Polygon testnet configuration...");
  
  const config = {
    networkName: process.env.NETWORK_NAME || "Polygon Mumbai Testnet",
    chainId: parseInt(process.env.CHAIN_ID) || 80001,
    rpcUrl: "http://localhost:8545",
    blockTime: parseInt(process.env.BLOCK_TIME) || 2,
    gasPrice: "20000000000", // 20 gwei
    gasLimit: "20000000",
    setupAt: new Date().toISOString()
  };
  
  // Ensure data directory exists
  const dataDir = "/app/data";
  if (!fs.existsSync(dataDir)) {
    fs.mkdirSync(dataDir, { recursive: true });
  }
  
  // Save network config
  const configPath = path.join(dataDir, "network-config.json");
  fs.writeFileSync(configPath, JSON.stringify(config, null, 2));
  
  console.log("✅ Network configuration saved:", configPath);
  console.log("🔗 Network:", config.networkName);
  console.log("🆔 Chain ID:", config.chainId);
  console.log("⏱️ Block Time:", config.blockTime, "seconds");
  
  return config;
}

setupNetwork()
  .then(() => {
    console.log("✅ Network setup completed");
  })
  .catch((error) => {
    console.error("❌ Network setup failed:", error);
    process.exit(1);
  });
EOF

# Create startup script
COPY <<EOF start-polygon.sh
#!/bin/bash
echo "🚀 Starting Hardhat Polygon Testnet..."

# Setup network configuration
echo "🔧 Setting up network configuration..."
npm run setup

# Wait a moment for setup to complete
sleep 2

# Compile contracts
echo "🔨 Compiling contracts..."
npx hardhat compile

# Start Hardhat node in background
echo "🌐 Starting Hardhat Polygon testnet node..."
npx hardhat node --hostname 0.0.0.0 --port 8545 &
HARDHAT_PID=$!

# Wait for node to be ready
echo "⏳ Waiting for Hardhat node to be ready..."
sleep 5

# Deploy contracts after node is ready
echo "📄 Deploying contracts..."
npm run deploy

# Start deployment API server in background
echo "📊 Starting deployment API server..."
node deployment-server.js &
DEPLOYMENT_SERVER_PID=$!

echo "✅ All services started successfully!"
echo "🔗 RPC Endpoint: http://localhost:8545"
echo "📊 Deployment API: http://localhost:8546"

# Keep the container running
wait $HARDHAT_PID
EOF

RUN chmod +x start-polygon.sh

# Create deployment API server
COPY <<EOF deployment-server.js
const express = require('express');
const cors = require('cors');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = 8546;

app.use(cors());
app.use(express.json());

// Health check
app.get('/health', (req, res) => {
  res.json({ status: 'healthy', timestamp: new Date().toISOString() });
});

// Get network configuration
app.get('/network', (req, res) => {
  try {
    const configPath = path.join('/app/data', 'network-config.json');
    if (fs.existsSync(configPath)) {
      const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
      res.json({ success: true, config });
    } else {
      res.status(404).json({ success: false, error: 'Network configuration not found' });
    }
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// Get deployment data
app.get('/deployment', (req, res) => {
  try {
    const deploymentPath = path.join('/app/data', 'deployed.json');
    if (fs.existsSync(deploymentPath)) {
      const data = JSON.parse(fs.readFileSync(deploymentPath, 'utf8'));
      res.json({ 
        success: true, 
        networkName: data.network,
        chainId: data.chainId,
        rpcEndpoint: 'http://localhost:8545',
        contracts: data.contracts,
        contractsMap: data.contracts,
        ...data 
      });
    } else {
      res.status(404).json({ success: false, error: 'Deployment data not found' });
    }
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// Save configuration (for first-time setup)
app.post('/configure', (req, res) => {
  try {
    const { networkConfig, adminWallet } = req.body;
    
    // Save network config
    const configDir = '/app/data';
    if (!fs.existsSync(configDir)) {
      fs.mkdirSync(configDir, { recursive: true });
    }
    
    const configPath = path.join(configDir, 'network-config.json');
    fs.writeFileSync(configPath, JSON.stringify(networkConfig, null, 2));
    
    // Save admin wallet
    const walletPath = path.join(configDir, 'admin-wallet.json');
    fs.writeFileSync(walletPath, JSON.stringify(adminWallet, null, 2));
    
    res.json({ success: true, message: 'Configuration saved successfully' });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

app.listen(PORT, '0.0.0.0', () => {
  console.log(`📊 Deployment server running on port ${PORT}`);
});

module.exports = app;
EOF

EXPOSE 8545 8546

CMD ["./start-polygon.sh"]