FROM node:20-alpine AS base

# Install system dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    curl \
    git

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY yarn.lock* ./

# Install dependencies
RUN yarn install --frozen-lockfile

# Development stage
FROM base AS development
# Copy source code
COPY . .
# Create data directory for persistence
RUN mkdir -p /app/data
# Set environment variables for hostname binding
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
# Expose port
EXPOSE 3000
# Start in development mode with hot reload
CMD ["yarn", "dev", "--hostname", "0.0.0.0"]

# Production stage
FROM base AS production
# Copy source code
COPY . .
# Create data directory for persistence
RUN mkdir -p /app/data
# Set environment variables for hostname binding
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
# Build the application
RUN yarn build
# Expose port
EXPOSE 3000
# Health check endpoint script
RUN echo '#!/bin/sh\ncurl -f http://localhost:3000/api/health || exit 1' > /healthcheck.sh && chmod +x /healthcheck.sh
# Start the application
CMD ["yarn", "next:start", "--hostname", "0.0.0.0"]