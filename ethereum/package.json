{
  "name": "infrasim-ethereum",
  "version": "1.0.0",
  "description": "Persistent containerized Ethereum simulation environment for InfraSim",
  "scripts": {
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "deploy:dao": "hardhat run scripts/deploy-dao-factory.ts --network localhost",
    "deploy:all": "npm run deploy && npm run deploy:dao",
    "node": "hardhat node --hostname 0.0.0.0 --port 8545",
    "test": "hardhat test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  }
}