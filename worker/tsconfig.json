{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["index.ts", "../src/app/api/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}